[Unit]
Description=Chen Cook reading website
After=network-online.target
Wants=network-online.target
[Service]
User=chencook
Group=chencook
WorkingDirectory=/opt/chen-cook
Environment=COOK_READER_DATA=/var/lib/chen-cook/reader
EnvironmentFile=-/etc/chen-cook/reader.env
EnvironmentFile=-/etc/chen-cook/revision.env
ExecStart=/opt/chen-cook/.venv/bin/uvicorn server:app --host 172.19.0.1 --port 8020 --workers 1 --proxy-headers --forwarded-allow-ips=172.19.0.0/16
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/chen-cook
MemoryMax=350M
[Install]
WantedBy=multi-user.target
