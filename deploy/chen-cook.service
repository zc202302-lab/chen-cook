[Unit]
Description=Chen Cook private book library
After=network-online.target
Wants=network-online.target
[Service]
User=chencook
Group=chencook
WorkingDirectory=/opt/chen-cook
EnvironmentFile=/etc/chen-cook/site.env
EnvironmentFile=-/etc/chen-cook/revision.env
ExecStart=/opt/chen-cook/.venv/bin/uvicorn cooklib.main:app --host 172.19.0.1 --port 8020 --workers 1 --proxy-headers --forwarded-allow-ips=172.19.0.0/16
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/chen-cook
MemoryMax=350M
[Install]
WantedBy=multi-user.target
